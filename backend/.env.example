# ---------------------------------------------------------------------------
# KRAKEN-Trust — configuration (copy to ../.env). Never commit the real file.
# ---------------------------------------------------------------------------

# development | production (production disables the interactive API docs and the
# simulated AIS track; secure cookies are a separate switch, COOKIE_SECURE)
ENVIRONMENT=production

# --- Secrets at rest -------------------------------------------------------
# Fernet key encrypting API keys and PKI private keys. Docker deployment: generated
# by `make secrets` in secrets/master_key (Docker secret, outside keys/ and backups).
# MASTER_KEY below overrides it (secret manager); keep it empty otherwise.
# Without Docker and without either, keys/master.key is generated (development only).
MASTER_KEY=

# --- First administrator ---------------------------------------------------
# Leave the password empty: a random one is printed ONCE in the backend logs
# (docker compose logs backend) and must be changed at first login.
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=

# --- Sessions / exposure ---------------------------------------------------
# Set to true as soon as the dashboard is served over HTTPS (Secure cookie + HSTS).
# Not implied by ENVIRONMENT=production: the default deployment serves plain HTTP
# on 127.0.0.1:8080 (CONSOLE_BIND). Expose it beyond this host only behind TLS.
COOKIE_SECURE=false
# Address the console is published on (docker compose). 0.0.0.0 = every interface:
# only behind a TLS reverse proxy, with COOKIE_SECURE=true.
# CONSOLE_BIND=127.0.0.1
SESSION_TTL_MINUTES=480
SESSION_IDLE_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# JSON list of allowed browser origins (no "*").
# CORS_ORIGINS=["https://kraken.example.gouv.fr"]

# --- Data sources (can also be set, tested and rotated from Administration) --
# Copernicus Data Space S3 (required to read SAR pixels):
#   https://eodata-s3keysmanager.dataspace.copernicus.eu/
ACCESS_KEY=
SECRET_KEY=
# Global Fishing Watch (AIS gaps, encounters, loitering): https://globalfishingwatch.org/our-apis/tokens
GFW_TOKEN=
# aisstream.io live AIS: https://aisstream.io/apikeys
AISSTREAM_API_KEY=
# AISHub second AIS feed (free for members sharing an AIS station): https://www.aishub.net/join-us
AISHUB_USERNAME=
# OpenSanctions vessel screening (free key for public-interest use): https://www.opensanctions.org/api/
OPENSANCTIONS_API_KEY=
# VesselAPI vessel registry + optional AIS feed (free plan: 150 calls / month): https://vesselapi.com/pricing
VESSELAPI_API_KEY=
# Incident notifications (Slack / Mattermost webhook, HTTPS public host only).
# Six channels: alertes, escalades, sla, surveillance, operations, securite.
# Put {channel} (or __CHANNEL__) in the URL to route each one to its own endpoint;
# otherwise a single URL is used and the payload carries "channel": "kraken-<name>".
# Empty = local PoC sink (http://notif-sink:8090/hooks/__CHANNEL__, see http://localhost:8090).
ALERT_WEBHOOK_URL=

# --- Surveillance ----------------------------------------------------------
# Scan new Sentinel-1 scenes automatically every N minutes (0 = manual only).
AUTO_SCAN_INTERVAL_MINUTES=0

LOG_LEVEL=INFO
