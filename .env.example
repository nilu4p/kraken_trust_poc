# KRAKEN-Trust — server deployment (copy to .env and fill in).

# Domain name whose DNS A record points to this server's public IP.
# Let's Encrypt issues the certificate for it (HTTP-01 challenge on port 80).
DOMAIN=
# Expiry notices from Let's Encrypt (optional but recommended).
LETSENCRYPT_EMAIL=
# 1 = Let's Encrypt staging (untrusted test certificate) while trying out the setup.
LETSENCRYPT_STAGING=0

# Publish ports 80 and 443 on every interface (default 127.0.0.1 = this machine only).
CONSOLE_BIND=127.0.0.1
